# URL pública do site (sem barra no fim). Usada nos links de convite.
NEXT_PUBLIC_SITE_URL=https://clubearena.com.br

# Supabase — sem essas duas variáveis o app roda em MODO DEMONSTRAÇÃO (dados em memória).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Assina os cookies de sessão do membro e do admin. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Senha única do admin (/admin)
ADMIN_PASSWORD=

# Z-API (WhatsApp). Sem isso, mensagens são só registradas no log.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Código de confirmação por WhatsApp no cadastro/login. Fora do MVP: deixe "false"
# até a Z-API estar configurada e houver sinal de fraude.
OTP_ATIVO=false

# Protege /api/cron/lembretes (lembrete de 30 min e 24 h ao convidado).
CRON_SECRET=
